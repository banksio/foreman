{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModuleList",
  "type": "object",
  "properties": {
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ModuleStatus"
      }
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "modules"
  ],
  "$defs": {
    "ModuleStatus": {
      "type": "object",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "command_group": {
          "type": [
            "string",
            "null"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "exclusive_resource": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "phases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Step"
          }
        },
        "reason": {
          "type": "string"
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "phases",
        "requires",
        "enabled",
        "available",
        "reason"
      ]
    },
    "Step": {
      "type": "string",
      "enum": [
        "cycle",
        "preflight",
        "upgrade",
        "reboot",
        "kernels",
        "workloads",
        "compose",
        "disk"
      ]
    }
  }
}
